# Byte-compiled / build artefacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated artifacts — regenerate with `python pipeline.py`
#
# `out/` is mostly regenerable, so it is NOT tracked: dumping a few hundred KB of JSON
# into history on every run is noise. The exceptions below are committed on purpose,
# because `verify.py` must work on a fresh clone with no prior pipeline run — that is
# the whole point of the verifier.
out/*
!out/ct.log
!out/ct_anchor.json
!out/verify_output.txt
!out/zeros.svg
!out/Z_0_100.svg
!out/explicit_error.svg
# These two are cited by name outside the repo (README, docs/ISSUE_ZETA_LAB.md),
# so they must resolve for someone who never runs the pipeline.
!out/odlyzko_audit.json
!out/odlyzko_negative_control.json

# Internal scratch
docs/_check.py
_scratch/

# The 1.8 MB reference table IS committed on purpose: the audit and its negative control
# are only meaningful against a real external file, and `pipeline.py` skips the external
# section when it is absent rather than pretending. Its audit JSON is regenerated.
data/*.json
!data/odlyzko_zeros1.txt
# scratch inputs for manual testing
_scratch/
